font-family = "Victor Mono"
theme = catppuccin-frappe.conf
font-thicken = true
font-thicken-strength = 200
background-opacity = 0.92

# keybind = clear
keybind = alt+left=unbind
keybind = alt+right=unbind

# Key bindings:
keybind = global:ctrl+grave_accent=toggle_quick_terminal
# keybind = ctrl+one=goto_tab:1
# keybind = ctrl+two=goto_tab:2
# keybind = ctrl+three=goto_tab:3
# keybind = ctrl+four=goto_tab:4
# keybind = ctrl+five=goto_tab:5
# keybind = ctrl+shift+t=new_tab
# keybind = ctrl+shift+n=new_window
keybind = ctrl+shift+comma=reload_config
keybind = ctrl+shift+q=close_surface
# keybind = ctrl+shift+i=inspector:toggle
keybind = ctrl+equal=increase_font_size:1
keybind = ctrl+minus=decrease_font_size:1
# keybind = ctrl+zero=reset_font_size
# keybind = ctrl+shift+v=new_split:right
# keybind = ctrl+shift+s=new_split:down
# keybind = ctrl+shift+k=goto_split:top
# keybind = ctrl+shift+j=goto_split:bottom
# keybind = ctrl+shift+h=goto_split:left
# keybind = ctrl+shift+l=goto_split:right
keybind = cmd+c=copy_to_clipboard
keybind = cmd+v=paste_from_clipboard
keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard
keybind = ctrl+shift+enter=toggle_fullscreen


# Let me close stuff in peace:
confirm-close-surface = false

# Include OS-specific configurations.
config-file = ?config-macos
config-file = ?config-linux
